		{"id":"100f959d18910322","type":"text","text":"The language DOES NOT yet have its own rules for word formation, like a work -> worker, swim -> swimming, etc.","x":-376,"y":-200,"width":594,"height":80},
		{"id":"8f054e94030967ad","type":"text","text":"All words ARE BORROWED from other languages or just INVENTED","x":-376,"y":-100,"width":594,"height":50},
		{"id":"a87daee37c4dbbde","type":"text","text":"A word must sound harmonious with those already existing in the language.","x":-376,"y":-20,"width":597,"height":50},
		{"id":"4506604b3645b9a3","type":"text","text":"A word must sound harmonious with those already existing in the language.","x":-376,"y":60,"width":597,"height":50},
		{"id":"3be59f40c2fe6cc2","type":"text","text":"We focus on Japanese, Latin (but without -los, -la and other 'Spanish' parts) and German sounding tone.","x":-348,"y":140,"width":542,"height":80}
